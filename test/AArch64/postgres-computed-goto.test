# Check that llvm-bolt can process the postgres binary for AArch64.
# Related to https://github.com/llvm/llvm-project/issues/120992#issuecomment-2605903532.

RUN: mkdir -p %p/Output
RUN: test -f %p/Output/postgres || \
RUN:   unzstd %p/Inputs/postgres.zst \
RUN:   -o %p/Output/postgres
RUN: llvm-bolt %p/Output/postgres -o %t 2>&1 | FileCheck %s \
RUN:   --implicit-check-not=BOLT-ERROR \
RUN:   --implicit-check-not='unable to get new address corresponding to input address 0x2cb1b0 in function ExecInterpExpr/1'

CHECK: BOLT-INFO: Target architecture: aarch64
CHECK: BOLT-INFO: enabling relocation mode
CHECK: BOLT-INFO: {{Starting stub-insertion pass|starting clustered relaxation pass}}
CHECK: BOLT-INFO: {{Inserted [0-9]+ stubs|relaxed [0-9]+ (calls|unconditional branches)}}
