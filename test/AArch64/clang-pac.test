# Check that llvm-bolt can processes clang-19 binary for aarch64 with
# relocations enabled, built with -mbranch-protection=pac-ret.

RUN: mkdir -p %p/Output
RUN: test -f %p/Output/clang-19 || \
RUN:   unzstd %p/Inputs/clang-19.zst \
RUN:   -o %p/Output/clang-19
RUN: test -f %p/Output/clang.fdata || \
RUN:   unzstd %p/Profiles/clang.fdata.zst \
RUN:   -o %p/Output/clang.fdata
RUN: llvm-bolt %p/Output/clang-19 -data=%p/Output/clang.fdata -reorder-blocks=ext-tsp \
RUN: -reorder-functions=hfsort -split-functions -split-all-cold -split-eh \
RUN: -dyno-stats -o %t 2>&1 | FileCheck %s
CHECK: BOLT-INFO: Target architecture: aarch64
CHECK: BOLT-INFO: setting __hot_end
